DJANGO_SECRET_KEY=troque-por-uma-chave-forte
DEBUG=False
ALLOWED_HOSTS=.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.vercel.app
SQLITE_PATH=/tmp/macro_dashboard.sqlite3

# Fonte principal: JSON público do projeto local via Cloudflare Tunnel.
USE_REMOTE_MARKET_JSON=True
REMOTE_MARKET_JSON_URL=https://SEU-TUNEL.trycloudflare.com/api/public-market-snapshot/
REMOTE_MARKET_JSON_TOKEN=troque-pelo-mesmo-token-do-projeto-local
REMOTE_MARKET_MAX_AGE_SECONDS=900
REMOTE_MARKET_CONNECT_TIMEOUT_SECONDS=5
REMOTE_MARKET_READ_TIMEOUT_SECONDS=30

# Evita 403/429 das fontes quando executadas diretamente na Vercel.
INVESTING_ENABLED=False
NEWS_ENABLED=False
ECONOMIC_CALENDAR_ENABLED=False

MARKET_CACHE_TTL=300
MARKET_HISTORY_DAYS=30
MARKET_CHART_HISTORY_HOURS=24
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=15
